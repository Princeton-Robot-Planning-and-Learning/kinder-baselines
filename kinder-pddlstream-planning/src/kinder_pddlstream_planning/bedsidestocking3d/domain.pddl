(define (domain bedsidestocking3d)
  (:requirements :strips :equality)
  (:predicates
    (Item ?o)
    (Requested ?o)
    (Pose ?o ?p)
    (Grasp ?o ?g)
    (BConf ?q)
    (ATraj ?t)
    (Kin ?o ?p ?g ?q ?t)
    (Usable ?o ?p)

    (CFreePosePose ?o ?p ?o2 ?p2)
    (CFreeTrajPose ?t ?o2 ?p2)
    (Clear ?o ?p ?o2 ?p2)

    (AtPose ?o ?p)
    (AtGrasp ?o ?g)
    (AtBConf ?q)
    (HandEmpty)
    (CanMove)

    (Delivered ?o)
    (Blocked ?o ?p)
    (UnsafePose ?o ?p)
    (UnsafeTraj ?t)
  )

  (:action move_base
    :parameters (?q1 ?q2)
    :precondition (and (BConf ?q1) (BConf ?q2) (AtBConf ?q1) (CanMove))
    :effect (and (AtBConf ?q2) (not (AtBConf ?q1)) (not (CanMove)))
  )

  (:action pick
    :parameters (?o ?p ?g ?q ?t)
    :precondition (and (Kin ?o ?p ?g ?q ?t)
                       (AtPose ?o ?p) (HandEmpty) (AtBConf ?q)
                       (not (UnsafeTraj ?t)))
    :effect (and (AtGrasp ?o ?g) (CanMove)
                 (not (AtPose ?o ?p)) (not (HandEmpty)))
  )

  (:action place
    :parameters (?o ?p ?g ?q ?t)
    :precondition (and (Kin ?o ?p ?g ?q ?t)
                       (AtGrasp ?o ?g) (AtBConf ?q)
                       (not (UnsafePose ?o ?p))
                       (not (UnsafeTraj ?t)))
    :effect (and (AtPose ?o ?p) (HandEmpty) (CanMove)
                 (not (AtGrasp ?o ?g)))
  )

  (:derived (Delivered ?o)
    (exists (?p) (and (Usable ?o ?p) (AtPose ?o ?p) (not (Blocked ?o ?p))))
  )
  (:derived (Blocked ?o ?p)
    (exists (?o2 ?p2) (and (Usable ?o ?p) (Pose ?o2 ?p2) (not (= ?o ?o2))
                           (not (Clear ?o ?p ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )
  (:derived (UnsafePose ?o ?p)
    (exists (?o2 ?p2) (and (Pose ?o ?p) (Pose ?o2 ?p2) (not (= ?o ?o2))
                           (not (CFreePosePose ?o ?p ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )
  (:derived (UnsafeTraj ?t)
    (exists (?o2 ?p2) (and (ATraj ?t) (Pose ?o2 ?p2)
                           (not (CFreeTrajPose ?t ?o2 ?p2))
                           (AtPose ?o2 ?p2)))
  )
)
